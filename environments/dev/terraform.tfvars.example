# ── HCS Connection ──────────────────────────────────────────────────────────
# Credentials: set via env vars to avoid committing secrets
#   export TF_VAR_access_key="<your-ak>"
#   export TF_VAR_secret_key="<your-sk>"
access_key = "" # override with TF_VAR_access_key env var
secret_key = "" # override with TF_VAR_secret_key env var

# REQUIRED — the IAM endpoint URL. The provider uses this to authenticate
# and to resolve project_name → project_id before any API call. If you
# leave it empty the provider falls back to a built-in template
# (`iam-apigateway-proxy.<empty>`) and every call fails with a malformed-URL
# error like:
#   Get "https://iam-apigateway-proxy.:443/v3/projects?name=..."
hcs_auth_url    = "https://iam-apigateway-proxy.<your-domain>/v3"
region          = "<your-hcs-region>"  # e.g. MTN_Cloud
domain_name     = "<your-tenant-name>" # HCS tenant / domain
project_name    = "<your-vdc-project>" # HCS project / VDC
skip_tls_verify = true

# ── Service Endpoint Overrides ───────────────────────────────────────────────
# These override per-service URLs. The IAM line here is for service-level
# IAM calls — it does NOT replace hcs_auth_url above; the provider needs both.
# Every service a module in this environment calls needs an entry here. A
# missing endpoint does not fail at plan time — it fails mid-apply, which on a
# slow resource can mean waiting an hour to find out.
#
# Verify each host resolves BEFORE the first apply that uses it:
#   nslookup rds.<region>.<your-domain>
#
# Some HCS deployments publish a service under a versioned name (OBS has been
# seen as "obsv3.<region>.<your-domain>"), and some resolve only through
# /etc/hosts rather than DNS. Check the hosts file if nslookup comes up empty:
#   Linux/macOS  /etc/hosts
#   Windows      C:\Windows\System32\drivers\etc\hosts
#
# OBS caveat: OBS uses virtual-hosted-style addressing, so the provider calls
# https://<bucket>.<obs-endpoint>/ — every bucket name needs its own DNS
# record. A hosts file cannot wildcard, so on a hosts-only deployment add one
# line per bucket, or ask for a "*.obs.<region>.<your-domain>" A record. An
# OBS create that hangs for minutes is this, not a slow API.
endpoints = {
  ecs     = "https://ecs.<region>.<your-domain>"
  ims     = "https://ims.<region>.<your-domain>"
  vpc     = "https://vpc.<region>.<your-domain>"
  evs     = "https://evs.<region>.<your-domain>"
  nat     = "https://nat.<region>.<your-domain>"
  obs     = "https://obs.<region>.<your-domain>"
  iam     = "https://iam-apigateway-proxy.<your-domain>"
  rds     = "https://rds.<region>.<your-domain>"
  gaussdb = "https://gaussdb.<region>.<your-domain>"
  cce     = "https://cce.<region>.<your-domain>"
}

# ── Project metadata ────────────────────────────────────────────────────────
project     = "myapp"
environment = "dev"
owner       = "platform-team"

###############################################################################
# STOP — service values do NOT belong in this file.
#
# This file holds only what every stack shares: credentials, the HCS
# connection, service endpoints, and project naming.
#
# Everything else lives in the per-service file next to the main-<service>.tf
# that consumes it. Copy each one you need:
#
#   cp network.auto.tfvars.example  network.auto.tfvars   # VPC, subnets, NAT
#   cp security.auto.tfvars.example security.auto.tfvars  # security groups
#   cp ecs.auto.tfvars.example      ecs.auto.tfvars       # instances, keypair
#   cp eip.auto.tfvars.example      eip.auto.tfvars       # EIPs, bandwidth
#   cp obs.auto.tfvars.example      obs.auto.tfvars       # buckets, objects
#   cp rds.auto.tfvars.example      rds.auto.tfvars       # MySQL / PostgreSQL
#   cp gaussdb.auto.tfvars.example  gaussdb.auto.tfvars   # openGauss
#   cp cce.auto.tfvars.example      cce.auto.tfvars       # Kubernetes
#   cp vdc.auto.tfvars.example      vdc.auto.tfvars       # users, groups, roles
#
# Terraform loads terraform.tfvars AND every *.auto.tfvars automatically, so a
# plain `terraform plan` sees all of them with no -var-file to remember.
#
# Why the split matters: *.auto.tfvars load AFTER terraform.tfvars, so a value
# set in both places silently takes the .auto.tfvars version. Defining service
# values here produces resources you did not expect from the file you were
# actually editing.
#
# Every service map defaults to {} and cce is gated behind cce_enabled, so a
# stack you have not configured creates nothing.
###############################################################################
