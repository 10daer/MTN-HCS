# ── HCS Connection ──────────────────────────────────────────────────────────
# Credentials: set via env vars to avoid committing secrets
#   export TF_VAR_access_key="<your-ak>"
#   export TF_VAR_secret_key="<your-sk>"
access_key = "" # override with TF_VAR_access_key env var
secret_key = "" # override with TF_VAR_secret_key env var

# REQUIRED — the IAM endpoint URL. The provider uses this to authenticate
# and to resolve project_name → project_id before any API call. If you
# leave it empty the provider falls back to a built-in template
# (`iam-apigateway-proxy.<empty>`) and every call fails with a malformed-URL
# error like:
#   Get "https://iam-apigateway-proxy.:443/v3/projects?name=..."
hcs_auth_url    = "https://iam-apigateway-proxy.<your-domain>/v3"
region          = "<your-hcs-region>"  # e.g. MTN_Cloud
domain_name     = "<your-tenant-name>" # HCS tenant / domain
project_name    = "<your-vdc-project>" # HCS project / VDC
skip_tls_verify = true

# ── Service Endpoint Overrides ───────────────────────────────────────────────
# These override per-service URLs. The IAM line here is for service-level
# IAM calls — it does NOT replace hcs_auth_url above; the provider needs both.
endpoints = {
  ecs = "https://ecs.<region>.<your-domain>"
  ims = "https://ims.<region>.<your-domain>"
  vpc = "https://vpc.<region>.<your-domain>"
  evs = "https://evs.<region>.<your-domain>"
  nat = "https://nat.<region>.<your-domain>"
  obs = "https://obs.<region>.<your-domain>"
  iam = "https://iam-apigateway-proxy.<your-domain>"
}

# ── Project metadata ────────────────────────────────────────────────────────
project     = "myapp"
environment = "dev"
owner       = "platform-team"

# ── Network ─────────────────────────────────────────────────────────────────
vpc_cidr              = "10.10.0.0/16"
public_subnet_cidrs   = ["10.10.1.0/24", "10.10.2.0/24"]
private_subnet_cidrs  = ["10.10.10.0/24", "10.10.11.0/24"]
availability_zones    = ["cn-east-3a", "cn-east-3b"]
dns_servers           = ["100.125.4.25"]
enable_nat_gateway    = true
eip_type              = "eip_public_Internet_01"  # matches your HCS external network
trusted_ssh_cidr      = "10.0.0.0/8"    # corporate network range

# ── EIP — Elastic IPs & Bandwidth ──────────────────────────────────────────
# Shared bandwidth pool (multiple EIPs share a single bandwidth allocation)
eip_shared_bandwidths = {
  shared_pool = {
    name = "dev-shared-bw"
    size = 50     # 50 Mbit/s shared across all attached EIPs
  }
}

# Dedicated-bandwidth EIPs (one EIP = one bandwidth)
eip_dedicated = {
  bastion = {
    bandwidth_size = 10
    name           = "bastion-eip"
  }
  # vpn = {
  #   bandwidth_size = 20
  #   bandwidth_name = "vpn-bandwidth"
  #   name           = "vpn-eip"
  # }
}

# Shared-bandwidth EIPs (multiple EIPs on the shared pool above)
eip_shared = {
  web_01 = {
    bandwidth_key = "shared_pool"
    name          = "web-eip-01"
  }
  web_02 = {
    bandwidth_key = "shared_pool"
    name          = "web-eip-02"
  }
}

# EIP-to-port/IP associations (bind EIPs to instances, VIPs, ELB, etc.)
# eip_associations = {
#   bastion_bind = {
#     eip_key = "bastion"
#     port_id = "<bastion-port-id>"
#   }
# }

# ── ECS — Instances ─────────────────────────────────────────────────────────
key_pair_name = "my-keypair"          # pre-existing key pair in HCS
image_name    = "Ubuntu 22.04 server 64bit"

# Web tier
web_instance_count   = 2
web_flavor_id        = "c6.large.2"
web_system_disk_type = "business_type_01"
web_system_disk_size = 50

# App tier
app_instance_count   = 2
app_flavor_id        = "c6.xlarge.2"
app_system_disk_type = "business_type_01"
app_system_disk_size = 50
app_data_disk_size   = 100

# Anti-affinity server groups (created automatically from defaults; override here if needed)
# ecs_web_server_groups = {
#   web_anti_affinity = { name = "web-anti-affinity", policies = ["anti-affinity"] }
# }
# ecs_app_server_groups = {
#   app_anti_affinity = { name = "app-anti-affinity", policies = ["anti-affinity"] }
# }

# Managed keypairs (optional — if you want Terraform to create and export a keypair)
# ecs_web_keypairs = {
#   web_key = { name = "web-keypair", key_file = "web-keypair.pem" }
# }
# ecs_app_keypairs = {
#   app_key = { name = "app-keypair", key_file = "app-keypair.pem" }
# }

# ── VDC — Users, Groups, Roles, Projects ────────────────────────────────────
vdc_id    = "<your-vdc-id>"       # 1-36 chars, lowercase letters/digits/hyphens
domain_id = "<your-domain-id>"    # tenant ID for role assignments

# Look up built-in roles by display name
vdc_existing_roles = {
  tenant_admin = { display_name = "Tenant Administrator" }
  tenant_guest = { display_name = "Tenant Guest" }
}

# Custom roles
vdc_roles = {
  ecs_operator = {
    name        = "ecs_operator"
    description = "Can list and manage ECS instances"
    type        = "XA"
    policy      = <<-EOF
      {
        "Depends": [],
        "Statement": [
          {
            "Action": ["ecs:cloudServers:list", "ecs:cloudServers:start", "ecs:cloudServers:stop"],
            "Effect": "Allow"
          }
        ],
        "Version": "1.1"
      }
    EOF
  }
}

# Projects (resource spaces) — name must start with "{region_id}_"
vdc_projects = {
  dev = {
    name         = "<region>_dev"
    display_name = "Development Environment"
    description  = "Dev resource space"
  }
}

# Users
vdc_users = {
  dev_admin = {
    name         = "dev_admin"
    display_name = "Dev Administrator"
    auth_type    = "LOCAL_AUTH"
    access_mode  = "default"
    description  = "Primary dev environment admin"
    # password set via: export TF_VAR_vdc_users='{ dev_admin = { ... password = "..." } }'
  }
  ci_bot = {
    name        = "ci_service_bot"
    auth_type   = "MACHINE_USER"
    access_mode = "programmatic"
    description = "CI/CD pipeline service account"
  }
}

# Groups
vdc_groups = {
  developers = {
    name        = "Developers"
    description = "Development team members"
  }
  ops = {
    name        = "Operations"
    description = "Operations / SRE team"
  }
}

# Group memberships
vdc_group_memberships = {
  dev_members = {
    group_key = "developers"
    user_keys = ["dev_admin"]
  }
}

# Group role assignments
vdc_group_role_assignments = {
  dev_team_project_access = {
    group_key = "developers"
    assignments = [
      {
        role_key    = "ecs_operator"
        project_key = "dev"
      }
    ]
  }
  ops_tenant_guest = {
    group_key = "ops"
    assignments = [
      {
        role_key  = "existing:tenant_guest"
        domain_id = "<your-domain-id>"
      }
    ]
  }
}

# ── OBS — Object Storage ────────────────────────────────────────────────────

# Buckets
obs_buckets = {
  # Logging bucket — warm storage with auto-expiration
  logs = {
    acl           = "log-delivery-write"
    storage_class = "WARM"
    versioning    = false
    force_destroy = true
    lifecycle_rules = [
      { name = "expire-logs", prefix = "access-log/", expiration_days = 30 }
    ]
  }

  # Artifact storage — versioned, standard
  artifacts = {
    acl           = "private"
    storage_class = "STANDARD"
    versioning    = true
    # Enable logging to the logs bucket
    logging = {
      target_bucket_key = "logs"
      target_prefix     = "access-log/artifacts/"
    }
  }

  # Static website bucket
  # website = {
  #   acl           = "public-read"
  #   storage_class = "STANDARD"
  #   website = {
  #     index_document = "index.html"
  #     error_document = "error.html"
  #   }
  #   cors_rules = [
  #     {
  #       allowed_origins = ["https://example.com"]
  #       allowed_methods = ["GET", "HEAD"]
  #       allowed_headers = ["*"]
  #       max_age_seconds = 3600
  #     }
  #   ]
  # }

  # Encrypted bucket with KMS
  # secrets = {
  #   acl        = "private"
  #   versioning = true
  #   encryption = true
  #   kms_key_id = "<kms-key-id>"
  # }

  # Fusion bucket (multi-AZ high availability)
  # fusion = {
  #   acl               = "private"
  #   storage_class     = "STANDARD"
  #   bucket_redundancy = "FUSION"
  #   fusion_allow_upgrade     = true
  #   fusion_allow_alternative = true
  # }
}

