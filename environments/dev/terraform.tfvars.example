# ── GaussDB OpenGauss ───────────────────────────────────────────────────────

# Parameter templates
gaussdb_parameter_templates = {
  dev_tuned = {
    name           = "dev-tuned-template"
    description    = "Tuned parameters for dev workloads"
    engine_version = "8.202"
    instance_mode  = "combined"
    parameters = [
      { name = "audit_system_object", value = "100" },
      { name = "autoanalyze",         value = "on" },
    ]
  }
}

# Instances
# NOTE: vpc_id, subnet_id, and security_group_id below use placeholder strings.
#       In practice, reference module.network outputs or hardcode known IDs.
#       Passwords should be set via environment variables:
#         export TF_VAR_gaussdb_instances='{ primary = { ... password = "..." } }'
gaussdb_instances = {
  # Centralized HA instance
  primary = {
    name              = "dev-gaussdb-primary"
    flavor            = "gaussdb.opengauss.ee.m6.2xlarge.x868.ha"
    password          = ""   # set via TF_VAR or override
    vpc_id            = "<vpc-id>"          # or use terraform_remote_state / data source
    subnet_id         = "<subnet-id>"
    security_group_id = "<sg-id>"
    ha_mode           = "centralization_standard"
    ha_replication_mode = "sync"
    ha_consistency      = "strong"
    volume_type       = "ULTRAHIGH"
    volume_size       = 100
    replica_num       = 3
    az_count          = 3
    configuration_key = "dev_tuned"
    backup_start_time = "02:00-03:00"
    backup_keep_days  = 7
    time_zone         = "UTC+01:00"
  }

  # Distributed instance (uncomment if needed)
  # analytics = {
  #   name              = "dev-gaussdb-analytics"
  #   flavor            = "gaussdb.opengauss.ee.dn.m6.2xlarge.8.in"
  #   password          = ""
  #   vpc_id            = "<vpc-id>"
  #   subnet_id         = "<subnet-id>"
  #   security_group_id = "<sg-id>"
  #   ha_mode           = "centralization_standard"
  #   volume_type       = "ULTRAHIGH"
  #   volume_size       = 480
  #   sharding_num      = 1
  #   coordinator_num   = 2
  #   az_count          = 3
  #   datastore_engine  = "GaussDB(for openGauss)"
  #   datastore_version = "8.202"
  # }
}

# ── RDS — Relational Database Service ────────────────────────────────────────

# RDS Instances
# NOTE: Passwords should be set via environment variables:
#       export TF_VAR_rds_instances='{ pg_primary = { ... db_password = "..." } }'
rds_instances = {
  # PostgreSQL primary/standby (HA)
  pg_primary = {
    name              = "dev-rds-pg-primary"
    flavor            = "rds.pg.n1.large.2.ha"
    vpc_id            = "<vpc-id>"
    subnet_id         = "<subnet-id>"
    security_group_id = "<sg-id>"
    availability_zone = ["cn-east-3a", "cn-east-3b"]
    db_type           = "PostgreSQL"
    db_version        = "12"
    db_password       = ""   # set via TF_VAR or override
    volume_type       = "ULTRAHIGH"
    volume_size       = 100
    ha_replication_mode = "sync"
    backup_start_time   = "02:00-03:00"
    backup_keep_days    = 7
    ssl_enable          = true
    time_zone           = "UTC+01:00"
    tags = {
      Tier = "database"
    }
  }

  # MySQL single instance (uncomment if needed)
  # mysql_app = {
  #   name              = "dev-rds-mysql"
  #   flavor            = "rds.mysql.xlarge.arm4.single"
  #   vpc_id            = "<vpc-id>"
  #   subnet_id         = "<subnet-id>"
  #   security_group_id = "<sg-id>"
  #   availability_zone = ["cn-east-3a"]
  #   db_type           = "MySQL"
  #   db_version        = "5.7"
  #   db_password       = ""
  #   volume_type       = "ULTRAHIGH"
  #   volume_size       = 100
  #   backup_start_time = "03:00-04:00"
  #   backup_keep_days  = 7
  #   lower_case_table_names = "1"
  #   parameters = [
  #     { name = "div_precision_increment", value = "12" },
  #   ]
  # }
}

# PostgreSQL databases
rds_pg_databases = {
  app_db = {
    instance_key = "pg_primary"
    name         = "app_db"
    owner        = "rdsAdmin"
  }
}

# PostgreSQL accounts
# NOTE: Passwords should be set via env vars:
#       export TF_VAR_rds_pg_accounts='{ app_user = { ... password = "..." } }'
rds_pg_accounts = {
  app_user = {
    instance_key = "pg_primary"
    name         = "app_user"
    password     = ""   # set via TF_VAR or override
  }
}

# PostgreSQL privileges
rds_pg_privileges = {
  app_user_access = {
    instance_key = "pg_primary"
    db_key       = "app_db"
    users = [
      { account_key = "app_user", schema_name = "public", readonly = false }
    ]
  }
}

