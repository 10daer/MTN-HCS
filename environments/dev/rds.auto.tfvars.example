###############################################################################
# rds.auto.tfvars — values for main-rds.tf
# Module: modules/rds → MySQL / PostgreSQL instances, DBs, accounts, audit
#
# Everything defaults to {} — nothing is created until you uncomment an
# instance. Network ids are per-instance, so paste them from
# `terraform output network_ids` after the network stack applies.
#
# CONTAINS PASSWORDS — this file is gitignored (*.tfvars). Prefer
# TF_VAR_-style injection or a secrets store for anything beyond dev.
###############################################################################

# ── Instances ─────────────────────────────────────────────────────────────────
# Key = logical name, referenced as instance_key by everything below.
#
# NETWORK IDS: OMIT THEM. Leave vpc_id / subnet_id / security_group_id out (or
# set them to "") and this stack uses the network stack's VPC, first public
# subnet and default SG automatically. That is what lets one `terraform plan`
# build everything in the right order — the reference creates a dependency
# edge, so Terraform waits for the VPC instead of racing it.
#
# Only set them explicitly to pin an instance to a subnet or SG this state does
# not manage. A pasted id goes stale the moment the network is rebuilt, and the
# apply then fails with DBS.200503 "VPC ID not found" — with no dependency edge
# to order it correctly either.
#
# availability_zone is a LIST: one AZ for single-node, two for HA (a ".ha"
# flavor) — note this differs from gaussdb, which takes a comma-separated
# string. The Lagos stack reports az0.dc0 and bms.az2; usable subnets live in
# az0.dc0, so HA needs a second usable AZ to exist first.
#
# The AZ here MUST match the AZ of subnet_id or placement fails.
#
# FLAVOR: verify in HCS Console -> RDS -> Create Instance. There is no
# hcs_rds_flavors data source, so a wrong code is only caught at apply time as
# "DBS.280434 Invalid specification code". rds.mysql.s1.xlarge is confirmed
# valid on lagos-mtn-1 (2026-09-05); rds.mysql.n1.large.2 is NOT.
#
# CAPACITY: "DBS.202309 The ECS compute resources are insufficient" means the
# HCS host pool for that flavor/AZ is full. Not a config error — use a smaller
# flavor, retry later, or ask the HCS admin to add capacity.
#
# vpc_id, subnet_id, availability_zone, db_type and db_version are ForceNew.
# security_group_id is required (unlike gaussdb, where it is optional).
# volume_type: ULTRAHIGH | LOCALSSD | CLOUDSSD | ESSD
# name must be 4–64 chars.
#
# rds_instances = {
#   mysql = {
#     name              = "lagos-mtn-1-dev-mysql"
#     flavor            = "rds.mysql.s1.xlarge"
#     db_type           = "MySQL"
#     db_version        = "8.0"
#     db_password       = "ChangeMe#2026"
#     volume_type       = "ULTRAHIGH"
#     volume_size       = 40
#     availability_zone = ["az0.dc0"]
#
#     # Omit these three to inherit from the network stack.
#     # vpc_id / subnet_id / security_group_id omitted on purpose — they are
#     # inherited from the network stack. Set them only to pin elsewhere.
#
#     backup_start_time = "02:00-03:00"
#     backup_keep_days  = 7
#     ssl_enable        = true
#   }
#
#   pg = {
#     name              = "lagos-mtn-1-dev-pg"
#     flavor            = "rds.pg.s1.xlarge"
#     db_type           = "PostgreSQL"
#     db_version        = "14"
#     db_password       = "ChangeMe#2026"
#     volume_type       = "ULTRAHIGH"
#     volume_size       = 40
#     availability_zone = ["az0.dc0"]
#     # vpc_id / subnet_id / security_group_id omitted on purpose — they are
#     # inherited from the network stack. Set them only to pin elsewhere.
#   }
# }

# ── MySQL databases / accounts / grants ───────────────────────────────────────
# rds_mysql_databases = {
#   app = { instance_key = "mysql", name = "appdb", character_set = "utf8mb4" }
# }
#
# rds_mysql_accounts = {
#   app = { instance_key = "mysql", name = "appuser", password = "ChangeMe#2026", hosts = ["10.10.%"] }
# }
#
# rds_mysql_privileges = {
#   app-rw = {
#     instance_key = "mysql"
#     db_key       = "app"
#     users        = [{ account_key = "app", readonly = false }]
#   }
# }

# ── PostgreSQL databases / accounts / grants / plugins ────────────────────────
# rds_pg_databases = {
#   app = { instance_key = "pg", name = "appdb", owner = "rdsAdmin" }
# }
#
# rds_pg_accounts = {
#   app = { instance_key = "pg", name = "appuser", password = "ChangeMe#2026" }
# }
#
# rds_pg_privileges = {
#   app-rw = {
#     instance_key = "pg"
#     db_key       = "app"
#     users        = [{ account_key = "app", schema_name = "public", readonly = false }]
#   }
# }
#
# rds_pg_plugins = {
#   stats = { instance_key = "pg", db_key = "app", name = "pg_stat_statements" }
# }

# ── SQL audit ─────────────────────────────────────────────────────────────────
# rds_sql_audits = {
#   mysql = {
#     instance_key = "mysql"
#     keep_days    = 7
#     audit_types  = ["INSERT", "UPDATE", "DELETE", "CREATE_USER", "DROP_USER"]
#   }
# }

# rds_existing_instances must stay {} — the provider exposes no
# hcs_rds_instance data source, and the module validates that it is empty.
# Reference unmanaged instances by pasting their id as a string instead.

###############################################################################
# STAGE 2 — databases, accounts and grants.
#
# Apply these AFTER the instance is up and in state. They reference it by
# instance_key, so a single apply that creates both usually works, but keeping
# them separate makes a failure unambiguous: instance, or account wiring.
#
# This is the part that exercises the module's cross-references
# (instance_key -> db_key -> account_key), which is where map-driven modules
# normally break.
#
# hosts uses MySQL wildcard syntax, not CIDR: "10.10.%" means the VPC range.
# "%" means anywhere — avoid it outside a throwaway test.
#
# rds_mysql_databases = {
#   app = {
#     instance_key  = "mysql"   # key from rds_instances above
#     name          = "appdb"
#     character_set = "utf8mb4"
#   }
# }
#
# rds_mysql_accounts = {
#   app = {
#     instance_key = "mysql"
#     name         = "appuser"
#     password     = "CHANGE_ME#2026"  # 8-32 chars, 3+ character types
#     hosts        = ["10.10.%"]
#   }
# }
#
# rds_mysql_privileges = {
#   app-rw = {
#     instance_key = "mysql"
#     db_key       = "app"      # key from rds_mysql_databases
#     users = [
#       { account_key = "app", readonly = false },  # key from rds_mysql_accounts
#     ]
#   }
# }
###############################################################################
