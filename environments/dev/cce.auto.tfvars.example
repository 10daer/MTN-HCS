###############################################################################
# cce.auto.tfvars — values for main-cce.tf
# Module: modules/cce → cluster, node pools, namespaces
#
# A CCE cluster is not map-driven, so this stack is gated: nothing is created
# while cce_enabled = false.
###############################################################################

# NOTE: `-target=module.cce` does NOT isolate this stack. CCE reads vpc_id and
# subnet_id from module.network, so Terraform pulls the network stack into the
# plan. If your state is missing those resources it will try to CREATE them —
# which fails with "VPC.0115 The router name has exist" when the VPC already
# exists under another state file. Confirm `terraform state list` shows the
# network resources before targeting CCE.
#
# Leave this false so a stray plan cannot build a cluster. A CCE cluster is the
# most expensive resource in this environment — destroy it after testing.
cce_enabled = false

# ── Cluster ───────────────────────────────────────────────────────────────────
# cce.s1.small  — single master, ≤50 nodes    (dev default)
# cce.s1.medium — single master, ≤200 nodes
# cce.s2.small  — HA masters, ≤50 nodes       (required for cce_cluster_multi_az)
# Cluster name. Empty = derived from name_prefix, lowercased with illegal
# characters replaced by hyphens — CCE allows ONLY lowercase letters, digits
# and hyphens, starting with a letter. A prefix like "lagos-mtn-1_A_and_E-dev"
# becomes "lagos-mtn-1-a-and-e-dev-cluster". Set this to override.
cce_cluster_name = ""

cce_cluster_flavor_id = "cce.s1.small"

# overlay_l2 | vpc-router | eni
cce_container_network_type = "overlay_l2"

# Leave empty for the provider default. If set, these must NOT overlap
# vpc_cidr (10.10.0.0/16) or each other.
cce_container_network_cidr = ""
cce_service_network_cidr   = ""

# iptables | ipvs
cce_kube_proxy_mode = "iptables"

# Multi-AZ masters need an HA flavor (cce.s2.*) AND more than one usable AZ —
# on the Lagos stack only az0.dc0 carries a usable subnet, so keep this false.
cce_cluster_multi_az = false

# ── API server exposure ───────────────────────────────────────────────────────
# An EIP *address* (not id) to expose the Kubernetes API publicly. Empty =
# private-only, reachable from inside the VPC. Create the EIP in
# eip.auto.tfvars first, then paste its address from `terraform output`.
cce_cluster_eip = ""

# ── Network placement ─────────────────────────────────────────────────────────
#
# STALE IDS: these are looked up once and pasted in. If the network stack is
# ever destroyed and rebuilt, every id below changes and the next apply fails
# with a "not found" error (RDS reports DBS.200503 "VPC ID not found").
# Re-read them after ANY rebuild:  terraform output network_ids
# Unset = the network stack's VPC and first public subnet. The subnet must have
# DNS servers configured (network.auto.tfvars sets dns_servers) or nodes fail
# to register with the cluster.
# cce_vpc_id    = "5c1e...."
# cce_subnet_id = "9a3f...."

# ── Node login ────────────────────────────────────────────────────────────────
# Must be a keypair that ALREADY exists in HCS — the cce module does not import
# one. Empty = fall back to key_pair_name from ecs.auto.tfvars.
cce_key_pair_name = ""

# ── Node pools ────────────────────────────────────────────────────────────────
# Key = pool name suffix. flavor_id and availability_zone must exist on this
# stack — check `terraform output discovered` for real AZ names. On lagos-mtn-1
# that is az0.dc0 (bms.az2 is bare-metal and carries no usable subnet).
#
# Node pools are ECS instances, so they are subject to the same host-pool
# capacity limits as RDS ("DBS.202309 The ECS compute resources are
# insufficient"). Create the cluster with cce_node_pools = {} FIRST — that
# separates "does CCE work" from "is there compute capacity" and avoids
# rebuilding a cluster to retry a node pool.
#
# The keypair must ALREADY exist in HCS; this module does not import one.
# cce_node_pools = {
#   workers = {
#     flavor_id          = "c6.xlarge.2"
#     initial_node_count = 1
#     availability_zone  = "az0.dc0"
#
#     root_volume_size = 50
#     root_volume_type = "SSD"
#     data_volumes = [
#       { size = 100, volumetype = "SSD" },
#     ]
#
#     # Autoscaling — min/max only apply when autoscaling_enabled = true
#     autoscaling_enabled      = true
#     min_node_count           = 1
#     max_node_count           = 5
#     scale_down_cooldown_time = 100
#     priority                 = 1
#
#     runtime = "containerd"
#     labels  = { role = "worker" }
#     taints  = []
#     tags    = {}
#   }
# }

# ── Namespaces ────────────────────────────────────────────────────────────────
# Key = namespace name.
# cce_namespaces = {
#   app        = { labels = { team = "backend" } }
#   monitoring = {}
# }

###############################################################################
# STAGE 2 — node pool and namespaces.
#
# Apply AFTER the cluster exists. Node pools are ECS instances drawn from the
# same host pool that rejected RDS with "DBS.202309 The ECS compute resources
# are insufficient" / "Failed to create the ECS" — so this is the real capacity
# test. Keeping it a separate apply means a capacity failure does not cost you
# the cluster (5+ minutes to rebuild).
#
# flavor_id     — a flavor NAME (e.g. "s2.large.4"), never a UUID. CCE node
#                 flavors are a SUBSET of ECS flavors: the flavor your plain
#                 ECS instances use may not be offered here. Read the list from
#                 HCS Console -> CCE -> <cluster> -> Create Node Pool, which is
#                 authoritative for the AZ. Wrong format gives "Get flavor
#                 ExtraSpecs error: EOF"; a valid name CCE does not support
#                 gives "... error: flavor not found".
#
#                 Confirmed available on lagos-mtn-1 / az0.dc0 (2026-09-06):
#                   s2.large.4     2 vCPU | 8 GiB    <- smallest, use for tests
#                   s2.xlarge.2    4 vCPU | 8 GiB
#                   s2.4xlarge.4   4 vCPU | 16 GiB
#                   s2.2xlarge.2   8 vCPU | 16 GiB
#                   s2.4xlarge.2  16 vCPU | 32 GiB
#                   s2.8xlarge.2  32 vCPU | 64 GiB
#
# root_volume_type / volumetype — the CCE node pool page offers only
#                 "Ultra-high I/O" here, which is SSD. SATA is not on offer for
#                 CCE nodes even though ECS accepts it.
# autoscaling   — off. Scaling is meaningless until one node can be placed.
# keypair       — must ALREADY exist in HCS; this module does not import one.
#                 Empty cce_key_pair_name falls back to ecs.auto.tfvars.
#
# cce_node_pools = {
#   workers = {
#     flavor_id          = "2U-4G"
#     initial_node_count = 1
#     availability_zone  = "az0.dc0"
#
#     root_volume_size = 50
#     root_volume_type = "SSD"
#     data_volumes = [
#       { size = 100, volumetype = "SSD" },
#     ]
#
#     autoscaling_enabled = false
#     runtime             = "containerd"
#     labels              = { role = "worker" }
#     taints              = []
#     tags                = {}
#   }
# }
#
# Namespaces need a reachable Kubernetes API, so they only work once at least
# one node is Ready — a cluster with zero nodes will fail these.
#
# cce_namespaces = {
#   app = { labels = { team = "backend" } }
# }
###############################################################################
